# Run `pnpm run setup` to create .env from this file with fresh random secrets.

# --- Required -------------------------------------------------------------
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/strata
# At least 32 characters each, and different from one another.
JWT_SECRET=
MEDIA_SIGNING_SECRET=

# --- Redis ----------------------------------------------------------------
# Required in production. Without it, development runs as a single node on a local timer.
REDIS_URL=redis://127.0.0.1:6379

# --- Web ------------------------------------------------------------------
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the app. Zero ignores X-Forwarded-For.
TRUST_PROXY_HOPS=0
# Set to the web build to serve the client from this process, for example ../web/dist
# WEB_DIST=

# --- Process role ---------------------------------------------------------
# all | api | worker. Split them in production by running one process of each.
ROLE=all

# --- Media ----------------------------------------------------------------
# `disk` stores uploads in MEDIA_DIR. Use `cloudinary` in production.
MEDIA_PROVIDER=disk
MEDIA_DIR=./uploads
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Web Push (optional) --------------------------------------------------
# Generate a pair with: pnpm --filter @strata/server exec web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- Tuning ---------------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
DELIVERY_SWEEP_SECONDS=15
BLOCK_COMPACT_THRESHOLD=200
RATE_LIMITS_ENABLED=true
LOG_LEVEL=info
